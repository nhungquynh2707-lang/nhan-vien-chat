# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG chia sẻ file .env cho ai.

# Khóa API Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Lấy từ ứng dụng trên developers.facebook.com
PAGE_ACCESS_TOKEN=
APP_SECRET=
# Tự đặt một chuỗi bất kỳ, rồi nhập đúng chuỗi này khi khai báo Webhook trên Meta
VERIFY_TOKEN=

# Tùy chọn
PORT=3000
MODEL=claude-haiku-5-5
# Phí ship và mức miễn phí ship (đồng) — dùng để tính tổng tiền chính xác
SHIP_FEE=30000
FREE_SHIP_FROM=500000
# Sau khi chuyển cho người thật, AI im lặng với khách đó bao nhiêu giờ
PAUSE_HOURS=12
# Phiên bản Graph API của Facebook
GRAPH_VERSION=v21.0
